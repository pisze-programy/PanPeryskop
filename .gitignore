# IDE
.idea/
.vscode/

# Swift Package Manager build artifacts (vendor SPM deps)
**/.build/
ios/vendor/YPImagePicker/Package.resolved

# Local machine-only seed tooling (clean-IP source). Whole dir is gitignored —
# it contains absolute paths (launchd plist), local env secrets, checkpoint state.
# Never commit any of admin/local/ — the data flows in via the public worker API.
admin/local/

# Staging + media produced by the local multikino fetch (regenerated on demand).
admin/seed/multikino-media/
admin/seed/multikino.json
