# IDE
.idea/
.vscode/

# Swift Package Manager build artifacts (vendor SPM deps)
**/.build/
ios/vendor/YPImagePicker/Package.resolved

# Local-only files (internal notes, scraped data, machine tooling) —
# everything lives under one ignored folder so nothing sensitive is named here.
_internal/

# Staging + media produced by the local/VPS per-source fetches (regenerated on demand).
admin/seed/*.json
admin/seed/*-media/
admin/vps/logs/
admin/vps/.env

# facebook scrape test dump
browser-ext/*.json
