name = "panperyskop-api"
main = "src/index.ts"
# workers.dev is intentionally disabled (no `workers_dev` key) — the only entrypoint
# is the custom domain api.panperyskop.app.
# 2026-03-24+: required by Browser Run binding's .quickAction() (kupbilecik scraping).
compatibility_date = "2026-03-24"
compatibility_flags = ["nodejs_compat"]

# Raise the CPU limit to the paid max (5 min) — kupbilecik Browser Run scraping and
# the parallel seed queue consumers need headroom past the 30s default.
[limits]
cpu_ms = 300_000


[observability.logs]
enabled = true
invocation_logs = true

[observability.traces]
enabled = true

# Daily event seed: load next day's events early morning Europe/Warsaw.
# 02:00 UTC = 04:00 CEST (summer) / 03:00 CET (winter).
# CRON_SCHEDULE is the single source of truth — mirrored into the dashboard via env.
# 02:00 daily seed; 04:00 daily audit cleanup (4-day retention); hourly liveness
# watchdog (marks batches stuck in created/fetching/ingesting as failed).
[triggers]
crons = [ "0 2 * * *", "0 4 * * *", "0 * * * *" ]

# Queue wake-ups for the v2 seed pipeline. The queue is NOT the state: seed_units
# (D1) is the durable work-list. A { type:'unit' } message drains the pending
# WORKER units; VPS units are claimed over HTTP by the VPS consumer.
#   pp-seed-fetch-jobs → worker unit wake-ups
#   panperyskop-dlq    → dead-lettered wake-ups
[[queues.producers]]
binding = "SEED_FETCH_QUEUE"
queue = "pp-seed-fetch-jobs"

[[queues.consumers]]
queue = "pp-seed-fetch-jobs"
max_batch_size = 10
max_batch_timeout = 30
max_retries = 3
retry_delay = 30
dead_letter_queue = "panperyskop-dlq"
max_concurrency = 10

[[queues.consumers]]
queue = "panperyskop-dlq"
max_batch_size = 10
max_batch_timeout = 30
max_retries = 2
retry_delay = 30
max_concurrency = 1

# Headless Chrome via Cloudflare Browser Run — used by browser-transport seed
# providers (kupbilecik). remote=true so `wrangler dev` matches deployed CF.
[browser]
binding = "BROWSER"
remote = true

[-- D1 database id is account-specific and gitignored (see wrangler.toml.example).
-- Copy this file to wrangler.toml and fill in your real database_id.
[[d1_databases]]
binding = "DB"
database_name = "panperyskop-db"
database_id = "REPLACE_WITH_YOUR_D1_DATABASE_ID"

[[r2_buckets]]
binding = "MEDIA"
bucket_name = "panperyskop-media"

[vars]
# Production mode: real OAuth id_token verification (Sign in with Apple is the
# only login). Local dev can override via .dev.vars (ENVIRONMENT=development).
ENVIRONMENT = "production"
APPLE_CLIENT_ID = "pl.piszeprogramy.panperyskop"
# Cron schedule mirrors [triggers] crons — dashboard reads this as single source of truth.
CRON_SCHEDULE = "0 2 * * *"
# goingapp scraping. Public Algolia app id; API key + Cloudinary sig are secrets
# (wrangler secret put ALGOLIA_API_KEY / CLOUDINARY_SIG)
ALGOLIA_APP_ID = "FAFFKUSLK0"
# GOOGLE_CLIENT_ID = ""  # removed with Google Sign-In (Apple-only login)

# Production entrypoint — single worker served on the custom domain. Media URLs are
# derived from the request origin (core/media.ts), so /media/* works here too.
[[routes]]
pattern = "api.panperyskop.app"
custom_domain = true
